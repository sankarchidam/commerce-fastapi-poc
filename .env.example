# Databricks SQL warehouse (Workspace -> SQL Warehouses -> <warehouse> -> Connection details)
DATABRICKS_HOST=dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
# Personal access token (User settings -> Developer -> Access tokens). Never commit a real one.
DATABRICKS_TOKEN=dapi-your-token-here

DATABRICKS_CATALOG=commerce_poc
DATABRICKS_SCHEMA_CORE=core
DATABRICKS_SCHEMA_RAW=raw
DATABRICKS_SCHEMA_METRICS=metrics

SHOPIFY_WEBHOOK_SECRET=dev-webhook-secret
API_KEY=dev-api-key

# Optional
# LOG_LEVEL=INFO
# WEBHOOK_APPLY_MODE=sync   # or background: 200 after landing, apply after the response
# DB_POOL_SIZE=8   # also bounds parallel MERGEs per webhook
